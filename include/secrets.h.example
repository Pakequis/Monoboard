/*
  WiFi credentials and weather reference city template — copy to secrets.h and
  fill in real values. secrets.h is gitignored and never committed. Omitting
  the WEATHER_* lines (or the whole file) falls back to Sao Paulo in config.h.
*/

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "your-ssid-here"
#define WIFI_PASSWORD "your-password-here"

#define WEATHER_CITY_LABEL "Sao Paulo, SP"
#define WEATHER_LATITUDE   "-23.5505"
#define WEATHER_LONGITUDE  "-46.6333"

#endif // SECRETS_H
